# ============================================
# 🔒 Variabili d'ambiente - WebCAD Antincendio
# ============================================
# Copia questo file come .env.local e compila i valori reali.
# NON committare mai .env.local su GitHub!

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://il-tuo-progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-chiave-anon-pubblica

# Google (Drive, Calendar, Tasks)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=il-tuo-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=il-tuo-client-secret
# Cartella radice dove viene organizzato l'archivio Fornitore/Anno (default hardcoded nel codice se omessa)
NEXT_PUBLIC_GOOGLE_DRIVE_ROOT_FOLDER_ID=1fgA-JTpfzPRIlJ8xJeQ95Grxi6hVUnB9
# Cartella "inbox" delle scansioni da smistare nella pagina /dashboard/scansioni
NEXT_PUBLIC_GOOGLE_DRIVE_SCANSIONI_FOLDER_ID=1IMJ-WTnVAJquaMA-A-QRvFjU0N64HA10
